{
  "name": "menugo-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n \"API,WEB\" -c \"blue,green\" \"npm run dev:api\" \"npm run dev:web\"",
    "clean": "node -e \"const fs=require('fs'); fs.rmSync('apps/web/.next', {recursive:true, force:true})\"",
    "dev:api": "npm run dev --workspace=@menugo/api",
    "dev:web": "npm run dev --workspace=@menugo/web",
    "build": "npm run build --workspaces --if-present",
    "test": "tsx --test --test-concurrency=1 packages/*/src/__tests__/*.test.ts apps/*/src/__tests__/*.test.ts",
    "smoke": "tsx scripts/smoke-test.ts",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "db:generate": "npm run db:generate --workspace=@menugo/database",
    "db:migrate": "npm run db:migrate --workspace=@menugo/database",
    "db:push": "npm run db:push --workspace=@menugo/database",
    "db:studio": "npm run db:studio --workspace=@menugo/database"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@types/ws": "^8.18.2",
    "concurrently": "^9.1.2",
    "drizzle-orm": "^0.45.4",
    "supertest": "^7.3.1",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  },
  "dependencies": {
    "pg": "^8.23.1",
    "ws": "^8.22.1"
  }
}
