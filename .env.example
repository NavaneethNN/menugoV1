# ==============================================================================
# MenuGo Production Environment Configuration (.env.example)
#
# IMPORTANT:
# - Do not commit actual secrets or production credentials to source control.
# - Supply these variables in your hosting provider's dashboard (e.g. Vercel, Railway, Neon).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database Configuration (Neon PostgreSQL)
# ------------------------------------------------------------------------------
# PostgreSQL pooled connection string from Neon dashboard.
# Must include '-pooler' in the host and '?sslmode=require'.
# Example: postgresql://[user]:[password]@[endpoint]-pooler.[region].aws.neon.tech/[dbname]?sslmode=require
DATABASE_URL=""

# Maximum database connections per serverless / container instance (default: 10 in prod)
DB_POOL_MAX="10"

# ------------------------------------------------------------------------------
# 2. Authentication (Better Auth)
# ------------------------------------------------------------------------------
# Cryptographically secure random string with at least 32 characters.
# Generate via: openssl rand -base64 32
BETTER_AUTH_SECRET=""

# Authoritative base URL for authentication endpoints on the backend API.
# In production: https://api.yourdomain.com or https://your-api.vercel.app
BETTER_AUTH_URL=""

# Custom root domain for cross-subdomain authentication cookies (optional).
# Example: ".yourdomain.com" (allows sharing session across app and api subdomains)
AUTH_COOKIE_DOMAIN=""

# SameSite cookie policy for session cookies (optional: "lax", "strict", "none")
# Defaults to "none" in cross-domain production, or "lax" for same-domain
AUTH_COOKIE_SAME_SITE="lax"

# ------------------------------------------------------------------------------
# 3. Application URLs & Networking
# ------------------------------------------------------------------------------
# Server port for standalone Express execution (ignored on serverless hosts like Vercel)
PORT="5001"

# Backend API server public URL
API_URL=""

# Public API URL accessible from the client browser
NEXT_PUBLIC_API_URL=""

# Frontend Web Application URL
NEXT_PUBLIC_APP_URL=""

# Canonical web application URL for server-side auth redirect validation
APP_URL=""

# Additional trusted CORS and auth origins (comma-separated list without spaces)
# Example: https://menugo.com,https://app.menugo.com,https://admin.menugo.com
TRUSTED_ORIGINS=""

# Optional internal rewrite target for Next.js edge reverse proxy
INTERNAL_API_URL=""

# ------------------------------------------------------------------------------
# 4. Cloudflare R2 Object Storage (Dish Photos & Restaurant Logos)
# ------------------------------------------------------------------------------
# Cloudflare Account ID from the Cloudflare Dashboard URL or Overview page
R2_ACCOUNT_ID=""

# R2 API token Access Key ID with Object Read & Write permissions
R2_ACCESS_KEY_ID=""

# R2 API token Secret Access Key
R2_SECRET_ACCESS_KEY=""

# Name of the Cloudflare R2 bucket for MenuGo media
R2_BUCKET_NAME=""

# Public delivery base URL for stored media (custom domain or r2.dev public URL)
# Example: https://media.yourdomain.com or https://pub-[hash].r2.dev
R2_PUBLIC_URL=""

# Optional custom S3-compatible endpoint (computed automatically from R2_ACCOUNT_ID if omitted)
# Example: https://[account-id].r2.cloudflarestorage.com
R2_ENDPOINT=""

# ------------------------------------------------------------------------------
# 5. Cinema Data Encryption (AES-256-GCM)
# ------------------------------------------------------------------------------
# Cryptographically secure 256-bit (32-byte) hex-encoded key used to encrypt
# theatre-specific payment gateway credentials (Razorpay / Paytm secrets) in the database.
# NEVER commit or expose this key. If lost, existing stored payment secrets cannot be decrypted.
# Generate via: openssl rand -hex 32
ENCRYPTION_KEY=""

# ------------------------------------------------------------------------------
# 6. Cinema Payment Gateway Webhook URLs (Reference Architecture)
# ------------------------------------------------------------------------------
# Note: Theatre-specific payment credentials (Razorpay Key ID/Secret, Paytm MID/Key)
# are configured per-theatre via the Cinema Admin Settings UI and stored encrypted in the DB.
#
# Webhook endpoints exposed by the API (configure these in Razorpay/Paytm merchant dashboards):
# - Razorpay Webhook URL:
#   https://[API_DOMAIN]/api/cinema/payments/webhook/{theatreId}/razorpay
# - Paytm Webhook / S2S Callback URL:
#   https://[API_DOMAIN]/api/cinema/payments/webhook/{theatreId}/paytm

# ------------------------------------------------------------------------------
# 7. Environment Mode
# ------------------------------------------------------------------------------
# Deployment environment: "production", "staging", or "development"
NODE_ENV="production"
