# ==============================================================================
# MenuGo Web Service Environment Variables (apps/web/.env.example)
# ==============================================================================

# Public API URL for client-side fetches and Better Auth React client
# Example: https://api.yourdomain.com
NEXT_PUBLIC_API_URL=""

# Canonical Public URL of this web application
# Example: https://app.yourdomain.com
NEXT_PUBLIC_APP_URL=""

# Optional internal API URL for Next.js edge rewrites (/api/*)
# Example: https://internal-api.service.internal:5001
INTERNAL_API_URL=""

# Runtime Environment
NODE_ENV="production"

