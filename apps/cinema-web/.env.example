# ==============================================================================
# MenuGo Cinema Web Service Environment Variables (apps/cinema-web/.env.example)
# ==============================================================================

# Public API URL for client-side fetches and Better Auth React client
NEXT_PUBLIC_API_URL="http://localhost:5001"

# Canonical Public URL of this cinema web application
NEXT_PUBLIC_APP_URL="http://localhost:3001"

# Restaurant Web Application URL (for cross-module redirection and links)
NEXT_PUBLIC_RESTAURANT_URL="http://localhost:3000"

# Optional internal API URL for Next.js edge rewrites (/api/*)
INTERNAL_API_URL="http://localhost:5001"

# Runtime Environment
NODE_ENV="production"
