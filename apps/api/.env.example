# ==============================================================================
# MenuGo API Service Environment Variables (apps/api/.env.example)
# ==============================================================================

# Database Connection (Neon PostgreSQL Pooled Connection)
# Must include '-pooler' and '?sslmode=require'
DATABASE_URL=""
DB_POOL_MAX="10"

# Authentication
# At least 32 random characters (openssl rand -base64 32)
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL=""
AUTH_COOKIE_DOMAIN=""
AUTH_COOKIE_SAME_SITE="lax"

# Networking & CORS
PORT="5001"
API_URL=""
APP_URL=""
NEXT_PUBLIC_APP_URL=""
TRUSTED_ORIGINS=""

# Cloudflare R2 Object Storage
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
R2_PUBLIC_URL=""
R2_ENDPOINT=""

# Runtime Environment
NODE_ENV="production"

