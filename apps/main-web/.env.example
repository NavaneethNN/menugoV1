# ==============================================================================
# MenuGo Main Platform Web Service Environment Variables (apps/main-web/.env.example)
# ==============================================================================

# Public API URL for client-side fetches and Better Auth React client
NEXT_PUBLIC_API_URL="http://localhost:5001"

# Canonical Public URL of this main platform application
NEXT_PUBLIC_APP_URL="http://localhost:3002"

# Restaurant Web Application URL
NEXT_PUBLIC_RESTAURANT_URL="http://localhost:3000"

# Cinema Web Application URL
NEXT_PUBLIC_CINEMA_URL="http://localhost:3001"

# Optional internal API URL for Next.js edge rewrites (/api/*)
INTERNAL_API_URL="http://localhost:5001"

# Runtime Environment
NODE_ENV="production"
